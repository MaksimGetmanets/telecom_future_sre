# {{ ansible_managed }}
token: "{{ k3s_token }}"
write-kubeconfig-mode: "{{ k3s_kubeconfig_mode }}"
tls-san:
  - "{{ k3s_api_endpoint }}"
{% for san in k3s_tls_san %}
  - "{{ san }}"
{% endfor %}
{% if k3s_disable | length > 0 %}
disable:
{% for d in k3s_disable %}
  - "{{ d }}"
{% endfor %}
{% endif %}
