# Запуск вне кластера (в кластере бот настраивается через Helm-чарт tgbot/chart и TF_VAR_*, .env там не нужен).
# Без TELEGRAM_BOT_TOKEN бот работает в режиме лога: алерты и диагностика пишутся в stdout.

# Токен от @BotFather. Чат подключается командой /start, TELEGRAM_CHAT_ID необязателен.
TELEGRAM_BOT_TOKEN=
# Закрепить чат заранее (необязательно, несколько через запятую)
TELEGRAM_CHAT_ID=
# Если задан, чат подключается только командой /start <код>
REGISTER_CODE=
# Где хранить список подключённых чатов (по умолчанию .tgbot/chats.json)
CHAT_STORE_PATH=
# Порт вебхука Alertmanager (по умолчанию 8080)
PORT=

# LLM-ассистент. kubectl -n monitoring port-forward svc/llm-assistant 8089:8080
LLM_ASSISTANT_URL=http://127.0.0.1:8089/diagnose
# нужен, только если на ассистенте задан DIAGNOSE_TOKEN
DIAGNOSE_TOKEN=

# remediator выполняет действия, подтверждённые кнопкой. kubectl -n monitoring port-forward svc/remediator 8081:8080
# Если REMEDIATOR_URL пуст, бот показывает диагностику без кнопок.
REMEDIATOR_URL=http://127.0.0.1:8081
# нужен, только если на remediator задан WEBHOOK_TOKEN
REMEDIATOR_TOKEN=
