TELEGRAM_BOT_TOKEN=your_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# LLM-ассистент. kubectl -n monitoring port-forward svc/llm-assistant 8089:8080
LLM_ASSISTANT_URL=http://127.0.0.1:8089/diagnose
# нужен, только если на ассистенте задан DIAGNOSE_TOKEN
DIAGNOSE_TOKEN=

# remediator выполняет действия, подтверждённые кнопкой. kubectl -n monitoring port-forward svc/remediator 8081:8080
# Если REMEDIATOR_URL пуст, бот показывает диагностику без кнопок.
REMEDIATOR_URL=http://127.0.0.1:8081
# нужен, только если на remediator задан WEBHOOK_TOKEN
REMEDIATOR_TOKEN=
