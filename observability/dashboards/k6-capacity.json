{
  "uid": "k6-capacity",
  "title": "k6: тест вместимости",
  "description": "Графики теста вместимости (make load-capacity): нагрузка, p95, ошибки, CPU. Требует enableRemoteWriteReceiver в Prometheus.",
  "tags": [
    "demo-shop",
    "k6"
  ],
  "editable": true,
  "schemaVersion": 39,
  "version": 1,
  "timezone": "browser",
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "graphTooltip": 1,
  "annotations": {
    "list": []
  },
  "templating": {
    "list": [
      {
        "name": "ds",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "refresh": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Нагрузка и p95 задержки",
      "description": "Нагрузка (запросов/с, правая ось) и p95 задержки по данным k6 (левая ось, мс). Точка, где p95 пересекает красную линию 300 мс, это предел вместимости по SLO",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "порог SLO 300 мс"
            },
            "properties": [
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    10,
                    10
                  ]
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              },
              {
                "id": "custom.fillOpacity",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "запросов/с (k6)"
            },
            "properties": [
              {
                "id": "custom.axisPlacement",
                "value": "right"
              },
              {
                "id": "unit",
                "value": "reqps"
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*мс.*"
            },
            "properties": [
              {
                "id": "unit",
                "value": "ms"
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(k6_http_reqs_total[30s]))",
          "legendFormat": "запросов/с (k6)"
        },
        {
          "refId": "B",
          "expr": "max(k6_http_req_duration_p95) * 1000 and on() (sum(rate(k6_http_reqs_total[1m])) > 0)",
          "legendFormat": "p95 задержки, мс (k6)"
        },
        {
          "refId": "C",
          "expr": "vector(300)",
          "legendFormat": "порог SLO 300 мс"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Доля ошибок 5xx (gateway)",
      "description": "Доля ответов 5xx по данным приложения. Таймауты на стороне клиента (k6) сюда не попадают, поэтому в итоговой сводке k6 процент может быть выше",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never"
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_server_requests_seconds_count{application=\"gateway\",uri=~\"/orders.*\",status=~\"5..\"}[30s])) / sum(rate(http_server_requests_seconds_count{application=\"gateway\",uri=~\"/orders.*\"}[30s]))",
          "legendFormat": "5xx"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Пропущенные итерации и VU",
      "description": "Если нагрузка не достигается, k6 пропускает итерации (dropped): сервис или сам k6 упёрся в предел",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 12,
        "y": 9,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never"
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(k6_dropped_iterations_total[30s]))",
          "legendFormat": "пропущено/с"
        },
        {
          "refId": "B",
          "expr": "max(k6_vus)",
          "legendFormat": "активных VU"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "CPU подов gateway и orders",
      "description": "Загрузка CPU (ядер) под нагрузкой; лимит чарта 1 ядро на под",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 0,
        "y": 17,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never"
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (pod) (rate(container_cpu_usage_seconds_total{namespace=\"demo\",container=~\"gateway|orders\"}[1m]))",
          "legendFormat": "{{pod}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "p95 задержки по данным приложений",
      "description": "То же по метрикам Micrometer (сервер): видно, какой из сервисов задерживает",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 12,
        "y": 17,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never"
          },
          "min": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "порог SLO 300 мс"
            },
            "properties": [
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    10,
                    10
                  ]
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              },
              {
                "id": "custom.fillOpacity",
                "value": 0
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, application) (rate(http_server_requests_seconds_bucket{application=~\"gateway|orders\",uri=~\"/orders.*\"}[1m])))",
          "legendFormat": "{{application}}"
        },
        {
          "refId": "B",
          "expr": "vector(0.3)",
          "legendFormat": "порог SLO 300 мс"
        }
      ]
    }
  ]
}